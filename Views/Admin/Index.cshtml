@model DashboardVM
@{
    ViewData["Title"] = "لوحة التحكم";
}
<h2 class="mb-4">لوحة التحكم</h2>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="stat-card">طلبات جديدة<br /><b>@Model.NewApplications</b></div></div>
    <div class="col-md-4"><div class="stat-card">كل الطلبات<br /><b>@Model.ApplicationsCount</b></div></div>
    <div class="col-md-4"><div class="stat-card">رسائل التواصل<br /><b>@Model.MessagesCount</b></div></div>
    <div class="col-md-4"><div class="stat-card">أنواع التأمين<br /><b>@Model.ProductsCount</b></div></div>
    <div class="col-md-4"><div class="stat-card">منشورات<br /><b>@Model.PostsCount</b></div></div>
    <div class="col-md-4">
        <div class="stat-card">
            حسابات بانتظار الاعتماد<br /><b>@Model.PendingUsers</b>
            @if (Model.PendingUsers > 0 && (User.IsInRole("Prog") || User.IsInRole("Admin")))
            {
                <div class="mt-2"><a asp-controller="Users" asp-action="Index" asp-route-filter="pending">مراجعة</a></div>
            }
        </div>
    </div>
</div>
<h5>آخر الطلبات</h5>
<table class="table table-striped">
    <thead><tr><th>الاسم</th><th>النوع</th><th>الهاتف</th><th>الحالة</th><th></th></tr></thead>
    <tbody>
    @foreach (var a in Model.RecentApplications)
    {
        <tr>
            <td>@a.FullName</td>
            <td>@a.Product?.Title</td>
            <td>@a.Phone</td>
            <td>@a.Status</td>
            <td><a asp-controller="Applications" asp-action="Details" asp-route-id="@a.Id">عرض</a></td>
        </tr>
    }
    </tbody>
</table>
