@inject IUnitOfWork<SiteInfo> _siteInfo
@inject IUnitOfWork<UserProfile> _userProfile
@inject UserManager<ApplicationUser> _userManager
@{
    var site = _siteInfo.Repository.GetAll().FirstOrDefault();
    var siteName = site?.Name ?? "الواحة العربية للتأمين";
    var logo = site?.LogoUrl;
    var logoSrc = !string.IsNullOrEmpty(logo) && logo.Contains('/') ? $"/upload/{logo}" : "/img/logo-mark.png";
    var profile = _userProfile.Repository.GetWhere(a => a.UserId == _userManager.GetUserId(User)).FirstOrDefault();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "لوحة التحكم") - @siteName</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="~/img/logo-mark.png" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="dash-body">
    <div class="dash-wrap">
        <aside class="dash-side">
            <a class="side-brand" asp-controller="Admin" asp-action="Index">
                <img src="@logoSrc" alt="" />
                <span>لوحة التحكم</span>
            </a>
            <nav class="side-nav">
                <a asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2"></i> الرئيسية</a>
                <a asp-controller="Applications" asp-action="Index"><i class="bi bi-file-earmark-text"></i> طلبات التأمين</a>
                <a asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart"></i> التقارير</a>
                <a asp-controller="Messages" asp-action="Index"><i class="bi bi-envelope"></i> رسائل التواصل</a>
                @if (User.IsInRole("Prog") || User.IsInRole("Admin"))
                {
                    <a asp-controller="Products" asp-action="Index"><i class="bi bi-shield-check"></i> أنواع التأمين</a>
                    <a asp-controller="Posts" asp-action="Index"><i class="bi bi-megaphone"></i> العروض والمنشورات</a>
                    <a asp-controller="Admin" asp-action="Company"><i class="bi bi-building"></i> بيانات الشركة</a>
                    <a asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> المستخدمون والصلاحيات</a>
                }
                <a asp-controller="Home" asp-action="Index" target="_blank"><i class="bi bi-globe"></i> الموقع العام</a>
                <a asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right"></i> خروج</a>
            </nav>
        </aside>
        <div class="dash-main">
            <header class="dash-top">
                <div>@siteName</div>
                <div class="d-flex align-items-center gap-3">
                    <div class="dropdown staff-notif">
                        <button class="btn btn-link position-relative p-0 text-decoration-none staff-notif-bell"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false" title="الإشعارات">
                            <i class="bi bi-bell fs-5"></i>
                            <span id="staff-notif-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end staff-notif-menu p-0 shadow">
                            <div class="staff-notif-head px-3 py-2 border-bottom fw-semibold">إشعارات الطلبات</div>
                            <div id="staff-notif-list" class="staff-notif-list"></div>
                            <div id="staff-notif-empty" class="px-3 py-3 text-muted small">لا توجد إشعارات جديدة</div>
                        </div>
                    </div>
                    <a class="dash-user-link" asp-controller="Account" asp-action="UserProfile" asp-route-userId="@_userManager.GetUserId(User)">
                        <i class="bi bi-person-circle"></i>
                        <span>@(profile?.DisplayName ?? User.Identity?.Name)</span>
                    </a>
                </div>
            </header>
            <div class="dash-content">
                <partial name="Partial/_toast" />
                <div id="staff-live-toasts" class="toast-container position-fixed top-0 start-0 p-3" style="z-index:1080;"></div>
                @Html.AntiForgeryToken()
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/dashboard-notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
