@inject IUnitOfWork<SiteInfo> _siteInfo
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var site = _siteInfo.Repository.GetAll().FirstOrDefault();
    var siteName = site?.Name ?? "الواحة العربية للتأمين";
    var logo = site?.LogoUrl;
    // Uploaded logos are stored as "folder/file"; anything else falls back to the bundled brand mark.
    var logoSrc = !string.IsNullOrEmpty(logo) && logo.Contains('/') ? $"/upload/{logo}" : "/img/logo-mark.png";
    var isStaff = User.IsInRole("Prog") || User.IsInRole("Admin") || User.IsInRole("Employee");
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "الرئيسية") - @siteName</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="~/img/logo-mark.png" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="public-body @(ViewData["BodyClass"])">
    <header class="site-header">
                <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="@logoSrc" alt="@siteName" class="brand-logo" />
                    <span>
                        <strong>@siteName</strong>
                        <small class="d-block slogan">@(site?.Slogan)</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="News">الأخبار</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">من نحن</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="WhoWeAre">من نكون</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">تواصل معنا</a></li>
                    </ul>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <a class="btn btn-gold" asp-controller="Apply" asp-action="Index">قدّم طلب تأمين</a>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (isStaff)
                            {
                                <a class="btn btn-outline-light" asp-controller="Admin" asp-action="Index">لوحة التحكم</a>
                            }
                            <a class="btn btn-outline-light" asp-controller="Account" asp-action="UserProfile" asp-route-userId="@UserManager.GetUserId(User)">حسابي</a>
                            <a class="btn btn-outline-light" asp-controller="Account" asp-action="Logout">خروج</a>
                        }
                        else
                        {
                            <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                            <a class="btn btn-outline-gold" asp-controller="Account" asp-action="Register">إنشاء حساب</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main>
        <partial name="Partial/_toast" />
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container py-4">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5>@siteName</h5>
                    <p>@(site?.Slogan)</p>
                </div>
                <div class="col-md-4">
                    <h5>تواصل معنا</h5>
                    <p class="mb-1"><i class="bi bi-telephone"></i> <a href="tel:@site?.Phone">@site?.Phone</a></p>
                    @if (!string.IsNullOrEmpty(site?.Phone2))
                    {
                        <p class="mb-1"><i class="bi bi-telephone"></i> @site.Phone2</p>
                    }
                    <p class="mb-1"><i class="bi bi-envelope"></i> <a href="mailto:@site?.Email">@site?.Email</a></p>
                    @{
                        var waDigits = new string((site?.WhatsAppNumber ?? site?.Phone ?? "").Where(char.IsDigit).ToArray());
                        var companyMap = MapLink.ForAddress(site?.Address, site?.MapUrl);
                    }
                    @if (!string.IsNullOrEmpty(waDigits))
                    {
                        <p class="mb-1"><i class="bi bi-whatsapp"></i> <a href="https://wa.me/@waDigits" target="_blank" rel="noopener">واتساب</a></p>
                    }
                    <p class="mb-0"><i class="bi bi-geo-alt"></i>
                        <a href="@companyMap" target="_blank" rel="noopener">@site?.Address</a>
                    </p>
                </div>
                <div class="col-md-4">
                    <h5>روابط</h5>
                    <a asp-controller="Apply" asp-action="Index">التقديم الإلكتروني</a><br />
                    <a asp-controller="Account" asp-action="Login">تسجيل الدخول</a><br />
                    <a asp-controller="Account" asp-action="Register">إنشاء حساب</a>
                </div>
            </div>
            <div class="text-center mt-3 small">© @DateTime.Now.Year @siteName — www.awai.ly</div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
