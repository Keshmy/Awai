@model IEnumerable<Awai.Models.Entities.IssuedPolicy>
@{
    ViewData["Title"] = "الوثائق الصادرة";
    var q = ViewBag.Query as string;
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-1">الوثائق الصادرة</h2>
        <p class="text-muted mb-0">وثائق السيارات الإجباري الصادرة من هذا الموقع عبر IMS. طلبات النموذج العادي موجودة في «طلبات التأمين».</p>
    </div>
    <form method="get" class="d-flex gap-2" style="min-width:280px">
        <input class="form-control" name="q" value="@q" placeholder="بحث: اسم، هاتف، لوحة، رقم LISA..." />
        <button class="btn btn-gold" type="submit">بحث</button>
    </form>
</div>

<table class="table align-middle">
    <thead>
        <tr>
            <th>التاريخ</th>
            <th>الاسم</th>
            <th>رقم المعاملة</th>
            <th>اللوحة</th>
            <th>الهاتف</th>
            <th>القسط</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.CreatedDateLocalTime</td>
            <td>@p.InsuredName</td>
            <td dir="ltr">@(p.TransactionCode ?? p.PolicyNumber ?? "—")</td>
            <td dir="ltr">@(p.PlateNumber ?? "—")</td>
            <td dir="ltr"><a href="tel:@p.Phone">@p.Phone</a></td>
            <td>@(p.TotalPremium?.ToString("N3") ?? "—")</td>
            <td><a asp-action="Details" asp-route-id="@p.Id">تفاصيل / إرسال</a></td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">لا توجد وثائق صادرة مطابقة.</p>
}
