@model Product
@{
    ViewData["Title"] = Model.Title;
}
<div class="container py-5">
    <div class="service-card mx-auto" style="max-width:640px">
        <div class="icon-circle"><i class="bi @Model.IconClass"></i></div>
        <h1>@Model.Title</h1>
        <p>@Model.ShortDescription</p>
        <div class="price-tag mb-3">
            <small>@(string.IsNullOrWhiteSpace(Model.PriceNote) ? "يبدأ من" : Model.PriceNote)</small>
            <strong>@Model.PriceDisplay</strong>
        </div>
        @if (!string.IsNullOrEmpty(Model.Details))
        {
            <p>@Model.Details</p>
        }
        <a class="btn btn-gold" asp-controller="Apply" asp-action="Index" asp-route-productId="@Model.Id">قدّم طلبك</a>
    </div>
</div>
