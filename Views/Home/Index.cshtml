@model HomeVM
@{
    ViewData["Title"] = "الرئيسية";
    var site = Model.Site;
}

<section class="hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <p class="gold-label">خدماتنا</p>
                <h1 class="hero-title">
                    @(site?.Name)
                    <span class="welcome-gold">نرحب بكم</span>
                </h1>
                <p class="lead">@(site?.Slogan) — حلول تأمينية متكاملة لحماية ما يهمك، للأفراد والشركات.</p>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <a class="btn btn-gold btn-lg" asp-controller="Apply" asp-action="Index">قدّم طلب تأمين الآن</a>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                        <a class="btn btn-outline-gold btn-lg" asp-controller="Account" asp-action="Register">إنشاء حساب</a>
                    }
                </div>
            </div>
            <div class="col-lg-5">
                <div class="logo-door" aria-hidden="false">
                    <div class="door-panel door-left"></div>
                    <div class="door-panel door-right"></div>
                    <div class="shield-frame">
                        @if (Model.Photos.Any())
                        {
                            <img src="/upload/@Model.Photos.First().ImageUrl" alt="@Model.Photos.First().Title" />
                        }
                        else
                        {
                            <div class="shield-placeholder"><img src="~/img/logo.png" alt="@site?.Name" /></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section news-section" id="news">
    <div class="news-watermark" aria-hidden="true"></div>
    <div class="container position-relative">
        <h2 class="section-title">الأخبار والعروض</h2>
        @if (Model.Posts.Any())
        {
            <div class="row g-4">
                @foreach (var post in Model.Posts)
                {
                    <div class="col-md-4">
                        <div class="post-card">
                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                            {
                                <img src="/upload/@post.ImageUrl" alt="@post.Title" />
                            }
                            <div class="post-date">@post.PublishedAt.ToLocalTime().ToString("dd-MM-yyyy")</div>
                            <h5>@post.Title</h5>
                            <p>@(post.Body.Length > 120 ? post.Body[..120] + "..." : post.Body)</p>
                            <a asp-controller="Home" asp-action="Post" asp-route-id="@post.Id">اقرأ المزيد</a>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-4">
                <a class="btn btn-outline-navy" asp-controller="Home" asp-action="News">المزيد من الأخبار</a>
            </div>
        }
        else
        {
            <p class="text-center text-muted mb-0">لا توجد أخبار منشورة حالياً.</p>
        }
    </div>
</section>

@if (Model.About != null)
{
    <section class="section">
        <div class="container">
            <h2 class="section-title">@Model.About.Title</h2>
            <p class="mx-auto" style="max-width:760px">@Model.About.Body</p>
            <div class="text-center"><a asp-controller="Home" asp-action="About">المزيد</a></div>
        </div>
    </section>
}

<section class="cta-band">
    <div class="container text-center">
        <p class="mb-2">في الواحة العربية للتأمين نلتزم بحماية ما يهمك وتوفير الاطمئنان لك ولأسرتك.</p>
        <a class="btn btn-gold" asp-controller="Apply" asp-action="Index">ابدأ التقديم</a>
    </div>
</section>
