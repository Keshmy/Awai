@{
    ViewData["Title"] = "تم استلام الطلب";
    var site = ViewBag.Site as SiteInfo;
    var waUrl = TempData["WhatsAppUrl"] as string;
    if (string.IsNullOrEmpty(waUrl))
    {
        var wa = new string((site?.WhatsAppNumber ?? site?.Phone ?? "218940001097").Where(char.IsDigit).ToArray());
        waUrl = $"https://wa.me/{wa}";
    }
    var waDisplay = site?.Phone ?? "+218 94-0001097";
}
<div class="container py-5" style="max-width:680px">
    <div class="text-center mb-4">
        <i class="bi bi-check-circle text-success" style="font-size:3rem"></i>
        <h2 class="mt-3">تم حفظ طلبك</h2>
        <p>سيتم مراجعة المستندات وتحديد السعر يدوياً، وسنتواصل معك.</p>
    </div>

    <div class="alert alert-success">
        <h5 class="alert-heading">للتواصل عبر واتساب</h5>
        <p class="mb-3">يمكنك مراسلتنا باسمك أو رقم هاتفك لمتابعة الطلب.</p>
        <a class="btn btn-success btn-lg w-100" href="@waUrl" target="_blank" rel="noopener">
            <i class="bi bi-whatsapp"></i> فتح واتساب — @waDisplay
        </a>
    </div>

    <div class="text-center">
        <a class="btn btn-gold" asp-controller="Home" asp-action="Index">العودة للرئيسية</a>
    </div>
</div>
