@model IEnumerable<InsuranceApplication>
@{
    ViewData["Title"] = "طلبات التأمين";
    var status = ViewBag.Status as string;
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="mb-0">طلبات التأمين</h2>
    <div class="btn-group">
        <a class="btn btn-sm @(string.IsNullOrEmpty(status) ? "btn-gold" : "btn-outline-secondary")" asp-action="Index">الكل</a>
        <a class="btn btn-sm @(status == "Submitted" ? "btn-gold" : "btn-outline-secondary")" asp-action="Index" asp-route-status="Submitted">جديد</a>
        <a class="btn btn-sm @(status == "Reviewed" ? "btn-gold" : "btn-outline-secondary")" asp-action="Index" asp-route-status="Reviewed">مراجع</a>
        <a class="btn btn-sm @(status == "Synced" ? "btn-gold" : "btn-outline-secondary")" asp-action="Index" asp-route-status="Synced">معتمد</a>
        <a class="btn btn-sm @(status == "Failed" ? "btn-gold" : "btn-outline-secondary")" asp-action="Index" asp-route-status="Failed">مرفوض</a>
    </div>
</div>

<table class="table align-middle">
    <thead>
        <tr>
            <th>التاريخ</th>
            <th>الاسم</th>
            <th>النوع</th>
            <th>السعر</th>
            <th>الهاتف</th>
            <th>الحالة</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td>@a.CreatedDateLocalTime</td>
            <td>@a.FullName</td>
            <td>@a.Product?.Title</td>
            <td>@(a.Product?.PriceDisplay ?? "—")</td>
            <td><a href="tel:@a.Phone">@a.Phone</a></td>
            <td><span class="badge @ApplicationStatusText.Css(a.Status)">@ApplicationStatusText.Arabic(a.Status)</span></td>
            <td><a asp-action="Details" asp-route-id="@a.Id">تفاصيل</a></td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">لا توجد طلبات في هذا التصنيف.</p>
}
