@model IEnumerable<ContactMessage>
@{
    ViewData["Title"] = "رسائل التواصل";
}
<h2>رسائل التواصل</h2>
<p class="text-muted">
    هذه الرسائل تأتي من نموذج <strong>تواصل معنا</strong> في الموقع العام
    (الاسم، الهاتف، البريد، ونص الرسالة). ليست طلبات تأمين — طلبات التأمين موجودة في تبويب طلبات التأمين.
</p>
<table class="table">
    <thead><tr><th>التاريخ</th><th>الاسم</th><th>الهاتف</th><th>البريد</th><th>الرسالة</th></tr></thead>
    <tbody>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.CreatedDateLocalTime</td>
            <td>@m.Name</td>
            <td>@m.Phone</td>
            <td>@m.Email</td>
            <td>@m.Message</td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">لا توجد رسائل بعد.</p>
}
