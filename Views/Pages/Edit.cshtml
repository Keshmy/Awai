@model PageContent
@{
    ViewData["Title"] = "تعديل الصفحة";
}
<h2>@Model.Key</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Key" />
    <div class="mb-3"><label asp-for="Title"></label><input asp-for="Title" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Body"></label><textarea asp-for="Body" class="form-control" rows="10"></textarea></div>
    <button class="btn btn-gold" type="submit">حفظ</button>
</form>
